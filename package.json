{
  "name": "hippo",
  "private": true,
  "version": "0.0.1",
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "docker compose up -d --wait && turbo run dev --filter=@hippo/server --filter=@hippo/web --ui=tui",
    "dev:server": "bun run --filter @hippo/server dev",
    "dev:web": "bun run --filter @hippo/web dev",
    "hippo": "bun run --filter @hippo/core hippo",
    "smoke": "bun run --filter @hippo/memory smoke",
    "db:push": "bun run --filter @hippo/db push",
    "db:studio": "bun run --filter @hippo/db studio",
    "typecheck": "turbo run typecheck",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "biome check --error-on-warnings .",
    "format": "biome format --write .",
    "demo": "bun run --filter @hippo/core demo",
    "evidence": "bun run --filter @hippo/server evidence",
    "restore": "bun run --filter @hippo/server restore",
    "diagnose": "bun run --filter @hippo/memory diagnose",
    "prune:people": "bun run --filter @hippo/server prune:people",
    "capacity": "bun run --filter @hippo/server capacity",
    "ops": "bun run --filter @hippo/server ops",
    "evidence:daily": "bash scripts/evidence-daily.sh",
    "measure:corrections": "bun run --filter @hippo/core measure:corrections"
  },
  "devDependencies": {
    "@bun-security-scanner/osv": "^1.0.0",
    "@biomejs/biome": "^2.5.14",
    "turbo": "^2.11.2",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "esbuild": ">=0.25.0"
  },
  "trustedDependencies": [
    "@biomejs/biome",
    "@tailwindcss/oxide",
    "@mysten/walrus-wasm",
    "esbuild"
  ],
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
