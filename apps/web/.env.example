# Google sign-in through Enoki zkLogin. Both values are public: the browser sends them.
# Leave either blank and the Google option does not appear. The Google OAuth client must
# list <origin>/ as an authorized redirect URI for every origin you serve, or set
# VITE_ENOKI_REDIRECT_URL to the one URL it does list.
VITE_ENOKI_API_KEY=
VITE_GOOGLE_CLIENT_ID=
VITE_ENOKI_REDIRECT_URL=
