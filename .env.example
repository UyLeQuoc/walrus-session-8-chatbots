# ── Walrus Memory (operator account, mainnet) ─────────────────────────────
# Create at https://memory.walrus.xyz with the dedicated Sessions wallet.
# MEMWAL_ACCOUNT_ID is the MemWalAccount OBJECT id, not your wallet address and
# not the delegate public key. Run: pnpm --filter @hippo/memory exec tsx scripts/find-account.ts
MEMWAL_ACCOUNT_ID=0x
MEMWAL_PRIVATE_KEY=            # delegate private key, 64 hex. Server only.
MEMWAL_SERVER_URL=https://relayer.memory.walrus.xyz
MEMWAL_PACKAGE_ID=0xe7c16fbea0560e7057e2bf7422feaa4fb313749fc69c9e9092fac7a33b81d7f5   # from GET /config, NOT the docs value (upgraded package)
MEMWAL_REGISTRY_ID=0x0da982cefa26864ae834a8a0504b904233d49e20fcc17c373c8bed99c75a7edd
SUI_NETWORK=mainnet

# ── LLM via OpenRouter (primary model must not be OpenAI/Anthropic) ───────
OPENROUTER_API_KEY=
LLM_MODEL=google/gemini-2.5-flash
LLM_FALLBACK_MODEL=qwen/qwen3-235b-a22b

# ── Database ──────────────────────────────────────────────────────────────
DATABASE_URL=postgres://hippo:hippo@localhost:5433/hippo

# ── Server ────────────────────────────────────────────────────────────────
PORT=8787
WEB_BASE_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
SESSION_SECRET=                # openssl rand -hex 32
KEY_ENCRYPTION_KEY=            # openssl rand -hex 32 (AES-256-GCM for users' delegate keys)

# Optional feedback survey shown on /start and on the /me page. A WalForm works
# well here: https://walform.wal.app
SURVEY_URL=

# ── Channels (each adapter starts only when its token is set) ─────────────
TELEGRAM_BOT_TOKEN=
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_SIGNING_SECRET=

# ── Web (Vite reads VITE_* only) ──────────────────────────────────────────
VITE_API_URL=http://localhost:8787
